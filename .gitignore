# ── monorepo root ignores (apps/web and services/browser keep their own too) ──

# dependencies
node_modules/
**/node_modules/

# env / secrets — never commit
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
.mono-secrets.env
**/.env.vercel.*

# build output
dist/
build/
**/dist/
**/build/
out/

# vercel / local
.vercel/
**/.vercel/

# claude machine-specific
.claude/settings.local.json
.claude/scheduled_tasks.lock

# python (services/preprocess) — it keeps its own .gitignore too, but these
# artifacts are generic enough to belong at the root. Deliberately NOT a copy of
# that file: it ignores `scripts/logs.sh` / `scripts/logs-tail.sh`, which at the
# root would also hide files in the monorepo's own scripts/ directory.
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
**/.venv/
.coverage
**/.coverage
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/

# editor / os
.DS_Store
*.log
.idea/
.vscode/

# Agent scratchpads. Never commit these — NEO-260 pushed 1.6M insertions of
# Maestro CI debug artifacts (screenshots, hierarchy dumps, logs) into this
# PUBLIC repo via `git add -A`. Agents are told to use the session scratchpad
# outside the worktree; this is the backstop for when one writes here anyway.
scratchpad/

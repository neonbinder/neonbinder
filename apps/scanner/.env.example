# Only for running from source against something other than production.
# Copy to .env (git-ignored). The packaged app needs none of this.
#
# A preview's Convex URL (https://<deployment>.convex.cloud). Left out, the
# app asks neonbinder.io where its backend is.
NEONBINDER_CONVEX_URL=
# A key made on that same deployment (Profile → API Keys). Left out, the app
# asks for one and saves it. Never commit it.
NEONBINDER_API_KEY=
# Optional: a SANE device name, when the first Fujitsu scanner isn't the one.
# SCANNER_DEVICE=

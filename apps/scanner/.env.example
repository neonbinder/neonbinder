# Copy to .env (git-ignored) and fill in.
# Your key from NeonBinder → Settings → API Keys. Never commit it.
NEONBINDER_API_KEY=
# The NeonBinder deployment: https://<deployment>.convex.cloud
NEONBINDER_CONVEX_URL=
# Optional: a SANE device name, when the first Fujitsu scanner isn't the one.
# SCANNER_DEVICE=

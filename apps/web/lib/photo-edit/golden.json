{
  "about": "NEO-481 hand-edit geometry, shared by apps/web vitest (lib/photo-edit/geometry.test.ts) and services/preprocess pytest. Parameters in, corner points and output sizes out. Change only with both sides in the same PR.",
  "conventions": {
    "frame": "Source pixels, origin top-left, y down. For a scan the source is the EXIF-uprighted extracted/ original; for a stored photo it is that photo.",
    "angle": "crop.angle is degrees clockwise on screen, in (-180, 180]. The box's own top edge becomes the output's top edge.",
    "turns": "Quarter turns clockwise, applied last, after the crop.",
    "corners": "The box's own top-left, top-right, bottom-right, bottom-left, in source pixels, before turns. A null crop is the whole frame. Compare with an absolute tolerance of 1e-3.",
    "scale": "A crop drawn on a frame of another size (crop.srcW x crop.srcH) scales uniformly by src[0] / crop.srcW.",
    "rounding": "Pixel sizes round half up: floor(v + 0.5). Never banker's rounding.",
    "output": "The rendered size before fitting: round(crop.w) x round(crop.h) (whole frame when crop is null), swapped by an odd turn.",
    "image": "Pillow Image.thumbnail((1600, 1600)) of output: aspect kept, never upscaled.",
    "thumb": "Pillow Image.thumbnail((360, 360)) of image.",
    "openingTurns": "A scan with no hand edit opens on turns = floor(((360 - rotationDegrees) mod 360) / 90 + 0.5) mod 4; rotationDegrees is the pipeline's counter-clockwise turn, null = 0."
  },
  "cases": [
    {
      "name": "no crop, no turn",
      "src": [3000, 4200],
      "edit": {
        "turns": 0,
        "crop": null
      },
      "expect": {
        "corners": [
          [0, 0],
          [3000, 0],
          [3000, 4200],
          [0, 4200]
        ],
        "output": [3000, 4200],
        "image": [1143, 1600],
        "thumb": [257, 360]
      }
    },
    {
      "name": "no crop, a quarter turn right",
      "src": [3000, 4200],
      "edit": {
        "turns": 1,
        "crop": null
      },
      "expect": {
        "corners": [
          [0, 0],
          [3000, 0],
          [3000, 4200],
          [0, 4200]
        ],
        "output": [4200, 3000],
        "image": [1600, 1143],
        "thumb": [360, 257]
      }
    },
    {
      "name": "no crop, upside down",
      "src": [3000, 4200],
      "edit": {
        "turns": 2,
        "crop": null
      },
      "expect": {
        "corners": [
          [0, 0],
          [3000, 0],
          [3000, 4200],
          [0, 4200]
        ],
        "output": [3000, 4200],
        "image": [1143, 1600],
        "thumb": [257, 360]
      }
    },
    {
      "name": "no crop, a quarter turn left",
      "src": [3000, 4200],
      "edit": {
        "turns": 3,
        "crop": null
      },
      "expect": {
        "corners": [
          [0, 0],
          [3000, 0],
          [3000, 4200],
          [0, 4200]
        ],
        "output": [4200, 3000],
        "image": [1600, 1143],
        "thumb": [360, 257]
      }
    },
    {
      "name": "upright crop inside a landscape scan",
      "src": [4000, 3000],
      "edit": {
        "turns": 0,
        "crop": { "cx": 2000, "cy": 1500, "w": 1000, "h": 1400, "angle": 0, "srcW": 4000, "srcH": 3000 }
      },
      "expect": {
        "corners": [
          [1500, 800],
          [2500, 800],
          [2500, 2200],
          [1500, 2200]

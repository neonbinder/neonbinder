      }
    },
    {
      "name": "stored 1600 photo trimmed small: never upscaled",
      "src": [1143, 1600],
      "edit": {
        "turns": 1,
        "crop": { "cx": 571.5, "cy": 800, "w": 300.2, "h": 420.4, "angle": -3, "srcW": 1143, "srcH": 1600 }
      },
      "expect": {
        "corners": [
          [410.604689, 597.943699],
          [710.393275, 582.232445],
          [732.395311, 1002.056301],
          [432.606725, 1017.767555]
        ],
        "output": [420, 300],
        "image": [420, 300],
        "thumb": [360, 257]
      }
    }
  ],
  "openingTurns": [
    { "rotationDegrees": null, "turns": 0 },
    { "rotationDegrees": 0, "turns": 0 },
    { "rotationDegrees": 90, "turns": 3 },
    { "rotationDegrees": 180, "turns": 2 },

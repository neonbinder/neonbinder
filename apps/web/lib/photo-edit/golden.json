        "turns": 0,
        "crop": { "cx": 2000, "cy": 1500, "w": 1200, "h": 1680, "angle": 30, "srcW": 4000, "srcH": 3000 }
      },
      "expect": {
        "corners": [
          [1900.384758, 472.538661],
          [2939.615242, 1072.538661],
          [2099.615242, 2527.461339],
          [1060.384758, 1927.461339]
        ],
        "output": [1200, 1680],
        "image": [1143, 1600],
        "thumb": [257, 360]
      }
    },
    {
      "name": "crop tilted 7.25 degrees counter-clockwise, then a quarter turn right",
      "src": [5184, 3456],
      "edit": {
        "turns": 1,
        "crop": { "cx": 2600.4, "cy": 1700.2, "w": 2100.3, "h": 1500.6, "angle": -7.25, "srcW": 5184, "srcH": 3456 }
      },
      "expect": {
